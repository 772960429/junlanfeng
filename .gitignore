# ==========================================
# 1. Python 运行产生的缓存文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境（如果你用了的话）
venv/
ENV/
env/

# ==========================================
# 2. 你的自动化脚本生成的中间文件（重点）
# ==========================================
# 所有的运行日志
*.log
task_log.txt
heartbeat.txt

# 带有时间戳的更新文件和核查报告（只提交最终的 JSON 和 pub.xlsx）
update_data/*_更新引用_*.xlsx
update_data/引用匹配核查报告_*.csv

# ==========================================
# 3. 操作系统和编辑器产生的垃圾文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 4. 敏感信息（防止 API Key 泄露）
# ==========================================
# 如果你的 API Key 写在配置文件里，记得忽略它
.env
config.ini